# 4 MB in the image header: IDF refuses to boot when the chip is smaller than
# the header says, and a larger chip just leaves the rest unused. So one
# image serves 4, 8 and 16 MB boards; partitions.csv fits in 4 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_FREERTOS_HZ=1000
# 2 x TCP_MSS. The stream is 250 B every 20 ms per client, so an 8192 B
# window buffers 640 ms of audio that nobody needs, and lwIP takes it from
# internal DRAM -- the same pool the Wi-Fi driver allocates its TX buffers
# from. Measured on device: internal free fell to 9968 B with three clients,
# and every station stalled at once while the capture loop kept perfect time.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_SNAPSERVER_ENABLE_MESH_LITE=y
CONFIG_MESH_LITE_ENABLE=y
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_MESH_SOFTAP_SSID_PREFIX="SnapMesh"
CONFIG_MESH_SOFTAP_PASSWORD="criticalmass"
CONFIG_LWIP_MAX_SOCKETS=24
# lwIP's tcpip task runs at priority 18. Left unpinned it also runs on core
# 1 and preempts audio_task (priority 6) there -- during a voice announcement
# that showed up as "Capture timeline drifted" four times in nine seconds.
# Core 0 already hosts the Wi-Fi driver it works with anyway.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# Per-task CPU load for the stats lines (main/cpu_stats.c). Diagnostic; the
# run-time counter is esp_timer based, so it costs one timer read per
# context switch.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# The default event loop runs Mesh-Lite's own IP_EVENT_STA_GOT_IP handlers
# and then mesh_client.c's one (device_config_t on the stack, logging,
# snapclient_start()). At the IDF default of 2304 B every client overflowed
# sys_evt right after getting its mesh IP and rebooted in a loop.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# The whole request header block must fit in this. 512 (the IDF default)
# is too small for an Android WebView: its User-Agent and Accept headers
# plus X-Requested-With came to more, and the settings page in the app
# failed with 431 "Header fields are too long".
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
# Wi-Fi and lwIP buffers go to PSRAM first. When the radio stalls, the 32
# dynamic TX buffers (~1.6 kB each) fill up; in internal RAM that took
# ~45 kB at once (2026-09-23, 19:28): the largest free block fell to 1 kB,
# no new connection -- web page, Snapcast, clients -- could be set up any
# more, and the server stayed unreachable until reset.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# The values the devices run and were tested with. Without them a fresh
# build (e.g. in CI, which has no sdkconfig) takes IDF's defaults for
# SPIRAM_TRY_ALLOCATE_WIFI_LWIP instead: 16 static RX buffers, an RX block-ack
# window of 16 and unlimited out-of-order segments per connection -- untested
# here, and a different Wi-Fi behaviour than what is on the boards.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=4
